#!/bin/sh /etc/rc.common
#
# rayhunter-openwrt-boot
#
# OpenWrt init script that re-enables ADB on the Quectel EP06 modem
# and sets up port forwarding after each router boot.
#
# Install:
#   cp rayhunter-openwrt-boot /etc/init.d/rayhunter-openwrt-boot
#   chmod 755 /etc/init.d/rayhunter-openwrt-boot
#   /etc/init.d/rayhunter-openwrt-boot enable

START=99
STOP=10

EP06_VID="0x2C7C"
EP06_PID="0x0306"

send_at() {
    local port="$1"
    local cmd="$2"
    local timeout="${3:-2}"

    stty -F "$port" 115200 raw -echo -echoe -echok -echoctl -echoke 2>/dev/null || true

    # Flush input
    cat "$port" > /dev/null 2>&1 &
    local flush_pid=$!
    sleep 0.1
    kill "$flush_pid" 2>/dev/null || true
    wait "$flush_pid" 2>/dev/null || true

    printf '%s\r\n' "$cmd" > "$port"

    local response=""
    response=$(timeout "$timeout" cat "$port" 2>/dev/null) || true
    echo "$response"
}

find_at_port() {
    for port in /dev/ttyUSB*; do
        [ -e "$port" ] || continue
        local resp
        resp=$(send_at "$port" "AT" 2)
        if echo "$resp" | grep -q "OK"; then
            echo "$port"
            return 0
        fi
    done
    return 1
}

unlock_adb() {
    local at_port="$1"

    # Get salt
    local resp
    resp=$(send_at "$at_port" "AT+QADBKEY?" 3)
    if ! echo "$resp" | grep -q "OK"; then
        logger -t rayhunter "AT+QADBKEY? failed"
        return 1
    fi

    local salt
    salt=$(echo "$resp" | grep '+QADBKEY:' | sed 's/.*+QADBKEY: *//' | tr -d '\r\n' | cut -c1-8)
    if [ -z "$salt" ] || [ ${#salt} -lt 8 ]; then
        logger -t rayhunter "Could not extract QADBKEY salt"
        return 1
    fi

    # Compute unlock key
    local full_hash
    full_hash=$(openssl passwd -1 -salt "$salt" "SH_adb_quectel")
    local unlock_key
    unlock_key=$(echo "$full_hash" | cut -c13-28)

    # Send unlock key
    resp=$(send_at "$at_port" "AT+QADBKEY=\"$unlock_key\"" 3)
    if ! echo "$resp" | grep -q "OK"; then
        logger -t rayhunter "AT+QADBKEY unlock failed"
        return 1
    fi

    # Enable ADB - modem may re-enumerate USB immediately, dropping serial
    # before response arrives, so empty response is OK.
    resp=$(send_at "$at_port" "AT+QCFG=\"usbcfg\",$EP06_VID,$EP06_PID,1,1,1,1,1,1,0" 3)
    if echo "$resp" | grep -q "ERROR"; then
        logger -t rayhunter "Failed to enable ADB via usbcfg"
        return 1
    fi

    return 0
}

setup_cellular() {
    # Establish the QMI cellular data connection on wwan0.
    # The ADB-enabled USB config keeps rmnet (QMI) active, but OpenWrt's
    # built-in modem manager may not recognize the reconfigured device,
    # so we set it up manually via uqmi.

    if ! command -v uqmi >/dev/null 2>&1; then
        logger -t rayhunter "uqmi not found, skipping cellular setup"
        return
    fi

    local qmi_dev="/dev/cdc-wdm0"
    [ -e "$qmi_dev" ] || { logger -t rayhunter "QMI device $qmi_dev not found"; return; }

    # Start the data connection (try empty APN first, then common APNs)
    local handle=""
    for apn in "" "internet"; do
        handle=$(uqmi -d "$qmi_dev" --start-network --apn "$apn" --autoconnect 2>/dev/null)
        if [ -n "$handle" ] && echo "$handle" | grep -q "^[0-9]"; then
            logger -t rayhunter "QMI data connection started (apn='$apn', handle=$handle)"
            break
        fi
    done

    # Get assigned IP settings
    local settings
    settings=$(uqmi -d "$qmi_dev" --get-current-settings 2>/dev/null)
    if [ -z "$settings" ]; then
        logger -t rayhunter "Could not get QMI IP settings"
        return
    fi

    # Parse IP settings from JSON using jsonfilter (built into OpenWrt)
    local ip gw mask dns1 dns2
    if command -v jsonfilter >/dev/null 2>&1; then
        ip=$(echo "$settings" | jsonfilter -e '@.ipv4.ip')
        gw=$(echo "$settings" | jsonfilter -e '@.ipv4.gateway')
        mask=$(echo "$settings" | jsonfilter -e '@.ipv4.subnet')
        dns1=$(echo "$settings" | jsonfilter -e '@.ipv4.dns1')
        dns2=$(echo "$settings" | jsonfilter -e '@.ipv4.dns2')
    else
        # Fallback: grep for quoted values line-by-line
        ip=$(echo "$settings" | grep '"ip"' | grep -o '[0-9.]*')
        gw=$(echo "$settings" | grep '"gateway"' | grep -o '[0-9.]*')
        mask=$(echo "$settings" | grep '"subnet"' | grep -o '[0-9.]*')
        dns1=$(echo "$settings" | grep '"dns1"' | grep -o '[0-9.]*')
        dns2=$(echo "$settings" | grep '"dns2"' | grep -o '[0-9.]*')
    fi

    if [ -z "$ip" ] || [ -z "$gw" ]; then
        logger -t rayhunter "Could not parse QMI IP settings"
        return
    fi

    # Configure wwan0 with raw-ip mode (required for QMI on Quectel modems)
    ifconfig wwan0 down 2>/dev/null
    echo Y > /sys/class/net/wwan0/qmi/raw_ip 2>/dev/null
    ifconfig wwan0 "$ip" netmask "${mask:-255.255.255.252}" up

    # Add default route if none exists
    if ! ip route | grep -q "^default"; then
        ip route add default via "$gw" dev wwan0
    fi

    # Configure DNS
    if [ -n "$dns1" ]; then
        echo "nameserver $dns1" >> /etc/resolv.conf
    fi
    if [ -n "$dns2" ]; then
        echo "nameserver $dns2" >> /etc/resolv.conf
    fi

    logger -t rayhunter "Cellular data active: ip=$ip gw=$gw dns=$dns1,$dns2"
}

start() {
    logger -t rayhunter "Waiting for modem to be ready..."

    # First check if ADB is already available (persists across reboots)
    local retries=15
    while [ $retries -gt 0 ]; do
        if adb devices 2>/dev/null | grep -q "device$"; then
            logger -t rayhunter "ADB already active, skipping unlock"
            break
        fi
        retries=$((retries - 1))
        sleep 2
    done

    # If ADB not already active, try to unlock it via AT commands
    if ! adb devices 2>/dev/null | grep -q "device$"; then
        logger -t rayhunter "ADB not active, attempting unlock..."

        local at_port=""
        retries=30
        while [ $retries -gt 0 ]; do
            at_port=$(find_at_port 2>/dev/null) && break
            retries=$((retries - 1))
            sleep 2
        done

        if [ -z "$at_port" ]; then
            logger -t rayhunter "Could not find modem AT port after waiting"
            return 1
        fi

        logger -t rayhunter "Found AT port: $at_port"
        sleep 5

        logger -t rayhunter "Unlocking ADB..."
        if ! unlock_adb "$at_port"; then
            logger -t rayhunter "ADB unlock failed"
            return 1
        fi

        logger -t rayhunter "ADB enabled, waiting for device..."
        sleep 5

        retries=10
        while [ $retries -gt 0 ]; do
            if adb devices 2>/dev/null | grep -q "device$"; then
                break
            fi
            retries=$((retries - 1))
            sleep 2
        done

        if ! adb devices 2>/dev/null | grep -q "device$"; then
            logger -t rayhunter "ADB device did not appear"
            return 1
        fi
    fi

    # Set up cellular data connection (QMI)
    setup_cellular

    # Start the daemon on the modem if not already running
    if ! adb shell ps 2>/dev/null | grep -q rayhunter-daemon; then
        logger -t rayhunter "Starting rayhunter-daemon on modem..."
        adb shell "setsid /data/rayhunter/rayhunter-daemon /data/rayhunter/config.toml >> /data/rayhunter/rayhunter.log 2>&1 </dev/null & sleep 2" 2>/dev/null
        sleep 3
        if adb shell ps 2>/dev/null | grep -q rayhunter-daemon; then
            logger -t rayhunter "rayhunter-daemon started successfully"
        else
            logger -t rayhunter "WARNING: rayhunter-daemon may not have started"
        fi
    else
        logger -t rayhunter "rayhunter-daemon already running on modem"
    fi

    # Set up port forwarding
    adb forward tcp:8080 tcp:8080
    logger -t rayhunter "ADB port forwarding active (tcp:8080)"

    # Allow LAN access to the forwarded port (adb forward binds to 127.0.0.1)
    sysctl -w net.ipv4.conf.all.route_localnet=1 >/dev/null 2>&1
    iptables -t nat -C PREROUTING -p tcp --dport 8080 -j DNAT --to 127.0.0.1:8080 >/dev/null 2>&1 || \
        iptables -t nat -A PREROUTING -p tcp --dport 8080 -j DNAT --to 127.0.0.1:8080
    logger -t rayhunter "LAN access to port 8080 enabled"

    # Start notification monitor in the background so it doesn't block boot.
    # It will wait for the daemon API to become available and read the ntfy URL.
    if [ -x /usr/local/bin/rayhunter-notify.sh ]; then
        (
            # Wait for daemon API to become available
            ntfy_url=""
            api_retries=10
            while [ $api_retries -gt 0 ]; do
                config_json=""
                if command -v curl >/dev/null 2>&1; then
                    config_json=$(curl -s --max-time 5 http://127.0.0.1:8080/api/config 2>/dev/null)
                else
                    config_json=$(wget -q -O - http://127.0.0.1:8080/api/config 2>/dev/null)
                fi
                if [ -n "$config_json" ] && command -v jsonfilter >/dev/null 2>&1; then
                    ntfy_url=$(echo "$config_json" | jsonfilter -e '@.ntfy_url' 2>/dev/null)
                elif [ -n "$config_json" ]; then
                    ntfy_url=$(echo "$config_json" | grep '"ntfy_url"' | grep -o 'https*://[^"]*')
                fi
                [ -n "$ntfy_url" ] && break
                api_retries=$((api_retries - 1))
                sleep 5
            done

            if [ -n "$ntfy_url" ]; then
                # Send boot-up notification
                logger -t rayhunter "Sending boot-up notification to ntfy"
                curl -s -o /dev/null \
                    -H "Title: Rayhunter Online" \
                    -H "Priority: low" \
                    -H "Tags: white_check_mark" \
                    -d "Rayhunter has started and is monitoring for IMSI catchers." \
                    "$ntfy_url" 2>/dev/null || true

                logger -t rayhunter "Notification monitor starting (ntfy=$ntfy_url)"
                exec /usr/local/bin/rayhunter-notify.sh "$ntfy_url" 30
            else
                logger -t rayhunter "No ntfy_url configured, notification monitor not started"
            fi
        ) &
    fi

    # Set up SD card sync cron job if script exists
    if [ -x /usr/local/bin/rayhunter-sync-sd.sh ]; then
        # Add cron entry if not already present
        if ! crontab -l 2>/dev/null | grep -q "rayhunter-sync-sd"; then
            (crontab -l 2>/dev/null; echo "*/5 * * * * /usr/local/bin/rayhunter-sync-sd.sh") | crontab -
            logger -t rayhunter "SD card sync cron job installed (every 5 minutes)"
        fi
    fi
}

stop() {
    # Stop notification monitor
    killall rayhunter-notify.sh 2>/dev/null || true

    # Stop daemon on modem
    adb shell killall rayhunter-daemon 2>/dev/null || true

    # Remove SD sync cron entry
    if crontab -l 2>/dev/null | grep -q "rayhunter-sync-sd"; then
        crontab -l 2>/dev/null | grep -v "rayhunter-sync-sd" | crontab -
    fi

    iptables -t nat -D PREROUTING -p tcp --dport 8080 -j DNAT --to 127.0.0.1:8080 2>/dev/null || true
    adb forward --remove tcp:8080 2>/dev/null || true

    # Tear down cellular
    ifconfig wwan0 down 2>/dev/null
    ip route del default dev wwan0 2>/dev/null || true

    logger -t rayhunter "Port forwarding, daemon, and cellular removed"
}
